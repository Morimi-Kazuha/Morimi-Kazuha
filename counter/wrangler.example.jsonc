{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morimi-pokemon-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "profile-visitor-counter",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "COUNTER_OFFSET": "0"
  }
}
